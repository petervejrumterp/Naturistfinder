# Apache Configuration for NaturistFinder in cPanel / subfolder
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Enable CORS if needed
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
  </IfModule>

  # 1. API routes: Route /api/* requests to api.php (for PHP hosting)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]

  # 2. Rewrite index.tsx to compiled JS bundle on Apache/LiteSpeed
  RewriteRule ^index\.tsx$ assets/app.js [L]

  # 2. If dist/ folder is present and user accesses root, prefer dist/index.html
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. Existing static files - serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA Fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# Ensure correct MIME types for JavaScript and assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType image/webp .webp
</IfModule>
